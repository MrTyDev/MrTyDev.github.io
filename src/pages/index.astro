---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Rack from '../components/Rack.astro';
import { TAGS } from '../content.config';
import { now, server } from '../data/site';
import { url } from '../lib/url';
import { Image } from 'astro:assets';
import dashboard from '../assets/server-dashboard.jpg';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order || b.data.date.valueOf() - a.data.date.valueOf(),
);
const notes = (await getCollection('notes')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---
<Base>
  <Hero />

  <section class="section wrap" aria-labelledby="now-title">
    <h2 id="now-title" class="visually-small">Right now</h2>
    <dl class="now">
      {now.map((n) => <div><dt>{n.label}</dt><dd>{n.text}</dd></div>)}
    </dl>
  </section>

  <section class="section wrap" id="projects" aria-labelledby="projects-title">
    <div class="section-head">
      <div>
        <h2 id="projects-title">Things I’ve built</h2>
        <p>Defence projects, school projects and things I made because I wanted them to exist.</p>
      </div>
      <div class="filters" role="group" aria-label="Filter projects">
        <button class="chip" aria-pressed="true" data-filter="all">All</button>
        {Object.entries(TAGS).map(([k, v]) => <button class="chip" aria-pressed="false" data-filter={k}>{v}</button>)}
      </div>
    </div>
    <div class="grid" id="project-grid">
      {projects.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>

  <section class="section wrap" id="homelab" aria-labelledby="lab-title">
    <div class="lab">
      <div class="lab-text">
        <h2 id="lab-title">The server in my apartment</h2>
        <p>I’d rather build a service than pay a monthly fee for it. So most of my hobby projects run on {server.machine.toLowerCase()} on a shelf at home, reachable from my phone wherever I am.</p>
        <p>With 4 GB of VRAM, every model has to earn its place in memory. That’s the same problem as edge AI, just at home, and it’s where I try things before they’re good enough for anything else.</p>
        <dl class="specs">
          {server.specs.map((s) => <><dt>{s.label}</dt><dd>{s.value}</dd></>)}
        </dl>
        <figure class="shot">
          <Image src={dashboard} alt="The monitoring dashboard I wrote for the server, showing temperature, CPU, memory, storage and GPU" widths={[480, 900]} sizes="(max-width: 860px) 100vw, 40vw" />
          <figcaption>The dashboard I wrote to keep an eye on it.</figcaption>
        </figure>
      </div>
      <Rack />
    </div>
  </section>

  <section class="section wrap" aria-labelledby="notes-title">
    <div class="section-head">
      <h2 id="notes-title">Notes</h2>
      <a href={url('/notes/')}>All notes</a>
    </div>
    <ul class="notes">
      {notes.map((n) => (
        <li><a href={url(`/notes/${n.id}/`)}>
          <time datetime={n.data.date.toISOString()}>{fmt(n.data.date)}</time>
          <div><h3>{n.data.title}</h3><p>{n.data.summary}</p></div>
        </a></li>
      ))}
    </ul>
  </section>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('#project-grid .card');
  buttons.forEach((btn) => btn.addEventListener('click', () => {
    const f = btn.dataset.filter!;
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
    cards.forEach((c) => { c.hidden = f !== 'all' && !c.dataset.tags!.split(' ').includes(f); });
  }));
</script>

<style>
  .visually-small { font-size: 1rem; letter-spacing: 0; margin-bottom: 0.9rem; color: var(--mist); font-weight: 500; }
  .card[hidden] { display: none; }
</style>
