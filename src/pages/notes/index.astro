---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { url } from '../../lib/url';

const notes = (await getCollection('notes')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---
<Base title="Notes" description="Short write-ups about things I'm building and learning.">
  <div class="wrap">
    <header class="page-head">
      <h1>Notes</h1>
      <p class="lede">Short write-ups about things I’m building and what I learned from them.</p>
    </header>
    <ul class="notes">
      {notes.map((n) => (
        <li><a href={url(`/notes/${n.id}/`)}>
          <time datetime={n.data.date.toISOString()}>{fmt(n.data.date)}</time>
          <div><h3>{n.data.title}</h3><p>{n.data.summary}</p></div>
        </a></li>
      ))}
    </ul>
  </div>
</Base>
