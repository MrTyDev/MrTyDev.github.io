---
import '../styles/global.css';
import { site, getContent, identity } from '../data/site';
import { url } from '../lib/url';
import { LANGS, lurl, switchPath, t, type Lang } from '../i18n/ui';

interface Props { lang: Lang; title?: string; description?: string }
const { lang, title } = Astro.props;
const tr = t(lang);
const description = Astro.props.description ?? getContent(lang).description;
const pageTitle = title ? `${title} | ${site.name}` : `${site.name}, ${tr.siteTitle}`;
const path = Astro.url.pathname;
const nav = [
  { label: tr.nav.projects, href: '/#projects' },
  { label: tr.nav.homelab, href: '/#homelab' },
  { label: tr.nav.notes, href: '/notes/' },
  { label: tr.nav.about, href: '/about/' },
];
const others = (Object.keys(LANGS) as Lang[]).map((l) => ({ lang: l, href: switchPath(path, l), ...LANGS[l] }));
---
<!doctype html>
<html lang={LANGS[lang].html}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <script is:inline>
    // Apply a saved theme before the first paint, so there's no flash.
    try { const t = localStorage.getItem('theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t; } catch {}
  </script>
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  {others.map((o) => <link rel="alternate" hreflang={o.html} href={new URL(o.href, Astro.site)} />)}
  <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Familjen+Grotesk:ital,wght@0,400;0,500;0,700;1,400&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
  {lang === 'zh'
    ? <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700&display=swap" rel="stylesheet" />
    : <link href={`https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;700&display=swap&text=${encodeURIComponent(identity.nameZh + LANGS.zh.short + LANGS.zh.label)}`} rel="stylesheet" />}
</head>
<body>
  <a class="skip" href="#main">{tr.skip}</a>
  <header class="wrap nav">
    <a class="brand" href={lurl(lang, '/')}><span class="brand-mark" aria-hidden="true">{site.short}</span>{site.name}</a>
    <div class="nav-right">
      <nav class="nav-links" aria-label={tr.navLabel}>
        {nav.map((n) => {
          const href = lurl(lang, n.href);
          return <a href={href} aria-current={!n.href.includes('#') && path.startsWith(href) ? 'page' : undefined}>{n.label}</a>;
        })}
        <a href="#contact">{tr.nav.contact}</a>
      </nav>
      <button class="theme-toggle" type="button" aria-pressed="false" aria-label={tr.darkMode} title={tr.darkMode}>
        <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"/></svg>
        <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4 8.5 8.5 0 1 0 20 14.5Z"/></svg>
      </button>
      <nav class="lang-switch" aria-label={tr.langLabel}>
        {others.map((o) => (
          <a href={o.href} hreflang={o.html} lang={o.html} aria-current={o.lang === lang ? 'true' : undefined} title={o.label}>{o.short}</a>
        ))}
      </nav>
    </div>
  </header>
  <main id="main"><slot /></main>
  <footer class="footer" id="contact">
    <div class="wrap">
      <p class="footer-big">{tr.footerBig}</p>
      <a class="footer-mail" href={`mailto:${site.email}`}>{site.email}</a>
      <div class="footer-row">
        <span>{tr.footerBuilt}</span>
        <nav aria-label={tr.elsewhere}>{site.links.map((l) => <a href={l.url}>{l.label}</a>)}</nav>
      </div>
    </div>
  </footer>
  <script is:inline>
    // Light/dark toggle. Starts from the system setting; a click overrides it
    // and is remembered on this device.
    (() => {
      const btn = document.querySelector('.theme-toggle');
      const root = document.documentElement;
      const sysDark = window.matchMedia('(prefers-color-scheme: dark)');
      const isDark = () => (root.dataset.theme ? root.dataset.theme === 'dark' : sysDark.matches);
      const sync = () => btn.setAttribute('aria-pressed', String(isDark()));
      btn.addEventListener('click', () => {
        const next = isDark() ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch {}
        sync();
      });
      sysDark.addEventListener('change', sync);
      sync();
    })();
  </script>
</body>
</html>
