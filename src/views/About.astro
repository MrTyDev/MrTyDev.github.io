---
import Base from '../layouts/Base.astro';
import { getContent, identity, site } from '../data/site';
import { lurl, t, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = t(lang);
const a = tr.about;
const c = getContent(lang);
---
<Base lang={lang} title={a.title} description={a.description}>
  <div class="wrap">
    <header class="page-head">
      <h1>{a.title}</h1>
      <p class="identity">
        <span lang="en">{identity.nameEn}</span>
        <span lang="zh-Hant-TW">{identity.nameZh}</span>
        <span>{a.studentId} {identity.studentId}</span>
      </p>
      <p class="lede">{a.lede}</p>
    </header>

    <div class="prose">
      {a.body.map((p) => <p set:html={p} />)}
    </div>

    <section class="section">
      <h2 style="margin-bottom:1.5rem">{a.experience}</h2>
      <ol class="timeline">
        {c.experience.map((e) => (
          <li>
            <p class="muted">{e.when}</p>
            <div>
              <h3>{e.role}</h3>
              <p class="muted">{e.org}</p>
              <p>{e.text} <a href={lurl(lang, e.link)}>{tr.readMore}</a></p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="section">
      <h2 style="margin-bottom:0.75rem">{a.education}</h2>
      {c.exchange.school && (
        <p style="margin:0 0 1rem"><strong>{a.exchange}{a.sep}{c.exchange.school}</strong><br /><span class="muted">{c.exchange.place}{a.sep}{c.exchange.when}</span></p>
      )}
      <p style="margin:0 0 1.5rem"><strong>{c.education.degree}</strong><br /><span class="muted">{c.education.school}{a.sep}{c.education.years}{a.end} {c.education.detail}</span></p>
      <dl class="rows">{c.education.courses.map((x) => <div><dt>{x.area}</dt><dd>{x.items}</dd></div>)}</dl>
    </section>

    <section class="section">
      <h2 style="margin-bottom:1.5rem">{a.skills}</h2>
      <dl class="rows">{c.skills.map((s) => <div><dt>{s.area}</dt><dd>{s.items}</dd></div>)}</dl>
    </section>

    <section class="section">
      <h2 style="margin-bottom:0.75rem">{a.work}</h2>
      <p class="prose">{a.workText} <a href={`mailto:${site.email}`}>{a.emailWord}</a>{a.end}</p>
    </section>
  </div>
</Base>
