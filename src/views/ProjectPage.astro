---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Cover from '../components/Cover.astro';
import type { Project } from '../lib/projects';
import { lurl, t, type Lang } from '../i18n/ui';

interface Props { lang: Lang; project: Project; prev?: Project; next?: Project }
const { lang, project, prev, next } = Astro.props;
const tr = t(lang);
const { Content } = await render(project.body);
const d = project.data;
---
<Base lang={lang} title={d.title} description={d.summary}>
  <article class="wrap">
    <header class="page-head">
      <a href={lurl(lang, '/#projects')}>{tr.allProjects}</a>
      <h1 style="margin-top:1rem">{d.title}</h1>
      <p class="lede">{d.summary}</p>
      <p class="meta">
        {d.role && <span>{d.role}</span>}
        {d.when && <span>{d.when}</span>}
        <span class="tags" style="margin:0">{d.tags.map((tag) => <span style={`--tag: var(--c-${tag}); display:inline-flex; gap:.35rem; align-items:center`}><i style="width:.55rem;height:.55rem;border-radius:2px;background:var(--tag);display:inline-block"></i>{tr.tags[tag]}</span>)}</span>
      </p>
    </header>
    <figure class="hero-cover">
      <Cover project={project} eager />
      {d.coverCaption && <figcaption>{d.coverCaption}</figcaption>}
    </figure>

    <div class="article">
      <div>
        <div class="prose"><Content /></div>
        {d.gallery.length > 0 && (
          <div class="gallery">
            {d.gallery.map((g) => (
              <figure class={g.phone ? 'is-phone' : ''}>
                <Image src={g.src} alt={g.alt} class={g.srcDark ? 'theme-light' : undefined} widths={[480, 900, 1400]} sizes="(max-width: 860px) 100vw, 60vw" />
                {g.srcDark && <Image src={g.srcDark} alt="" class="theme-dark" widths={[480, 900, 1400]} sizes="(max-width: 860px) 100vw, 60vw" />}
                {g.caption && <figcaption>{g.caption}</figcaption>}
              </figure>
            ))}
          </div>
        )}
      </div>
      <aside class="side">
        {d.evidence.length > 0 && (
          <section class="evidence">
            <h2>{d.evidenceTitle ?? tr.numbers}</h2>
            <dl>{d.evidence.map((e) => <div><dt>{e.label}</dt><dd>{e.value}</dd></div>)}</dl>
          </section>
        )}
        {d.links.length > 0 && (
          <section>
            <h2>{tr.readMore}</h2>
            <ul>{d.links.map((l) => <li><a href={l.url}>{l.label}</a></li>)}</ul>
          </section>
        )}
        {d.stack.length > 0 && (
          <section>
            <h2>{tr.builtWith}</h2>
            <ul class="stack">{d.stack.map((s) => <li>{s}</li>)}</ul>
          </section>
        )}
      </aside>
    </div>

    <nav class="pager" aria-label={tr.moreProjects}>
      {prev ? <a href={lurl(lang, `/projects/${prev.id}/`)}>{tr.newer}: {prev.data.title}</a> : <span />}
      {next ? <a href={lurl(lang, `/projects/${next.id}/`)}>{tr.older}: {next.data.title}</a> : <span />}
    </nav>
  </article>
</Base>
