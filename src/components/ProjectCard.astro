---
import Cover from './Cover.astro';
import type { Project } from '../lib/projects';
import { lurl, t, type Lang } from '../i18n/ui';

interface Props { project: Project; lang: Lang }
const { project, lang } = Astro.props;
const { title, summary, tags, featured } = project.data;
const tagLabels = t(lang).tags;
---
<a class:list={['card', { 'is-featured': featured }]} href={lurl(lang, `/projects/${project.id}/`)} data-tags={tags.join(' ')}>
  <Cover project={project} useClip />
  <div class="card-body">
    <h3>{title}</h3>
    <p>{summary}</p>
    <ul class="tags">
      {tags.map((tag) => <li style={`--tag: var(--c-${tag})`}>{tagLabels[tag]}</li>)}
    </ul>
  </div>
</a>
