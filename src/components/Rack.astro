---
import { getCollection } from 'astro:content';
import { server } from '../data/site';
import { url } from '../lib/url';

const units = (await getCollection('projects', (p) => !!p.data.rack))
  .sort((a, b) => a.data.rack!.order - b.data.rack!.order);
---
<div class="rack" role="list" aria-label={`Services running on ${server.name}`}>
  {units.map((p, i) => (
    <a class="unit" role="listitem" href={url(`/projects/${p.id}/`)} style={`--tag: var(--c-${p.data.tags[0]}); --d: ${i * 0.7}s`}>
      <span class="led" aria-hidden="true"></span>
      <span><strong>{p.data.title}</strong><small>Replaces: {p.data.rack!.replaces}</small></span>
      <span class="port" aria-hidden="true">u{String(i + 1).padStart(2, '0')}</span>
    </a>
  ))}
  {server.extras.map((name, i) => (
    <div class="unit dim" role="listitem" style={`--d: ${(units.length + i) * 0.7}s`}>
      <span class="led" aria-hidden="true"></span>
      <span><strong>{name}</strong></span>
      <span class="port" aria-hidden="true">u{String(units.length + i + 1).padStart(2, '0')}</span>
    </div>
  ))}
</div>
